= form_with(model: @dealz) do |form|
  - if @dealz.errors.any?
    #error_explanation
      %h2= "#{pluralize(@dealz.errors.count, "error")} prohibited this dealz from being saved:"
      %ul
        - @dealz.errors.full_messages.each do |message|
          %li= message

  .field
    = form.label :item_id
    = form.select :item_id, options_for_select(TransactionRecord.where(id: @dealz.transaction_record_id).first.company.items.map { |item| [item.name, item.id] }, @dealz.item_id)
  .field
    = form.label :transaction_record_id
    = form.text_field :transaction_record_id, name: "dealz[transaction_record_id]", value: @dealz.transaction_record_id
  .field
    = form.label :quantity
    = form.number_field :quantity
  .field
    = form.label :price
    = form.text_field :price
  .field
    = form.label :vat_rate_id
    = form.text_field :vat_rate_id
  .field
    = form.label :total_excl_vat
    = form.text_field :total_excl_vat
  .field
    = form.label :total_incl_vat
    = form.text_field :total_incl_vat
  .actions
    = form.submit
