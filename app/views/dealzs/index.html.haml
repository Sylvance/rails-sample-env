%h1 Listing Dealzs

%table
  %thead
    %tr
      %th item
      %th transaction_record
      %th quantity
      %th price
      %th vat_rate
      %th total_excl_vat
      %th total_incl_vat
      %th Actions

  %tbody
    - @dealzs.each do |dealz|
      %tr
        %td= dealz.item_id
        %td= dealz.transaction_record_id
        %td= dealz.quantity
        %td= dealz.price
        %td= dealz.vat_rate_id
        %td= dealz.total_excl_vat
        %td= dealz.total_incl_vat
        %td
          %button{type: "button", style: "background-color: oklch(0.508 0.118 165.612);"}
            = link_to 'Show', dealz, style: "color: white;"
        %td
          %button{type: "button", style: "background-color: oklch(0.488 0.243 264.376);", onclick: "document.getElementById('edit-dealz-dialog-#{dealz.id}').showModal()"} Edit
          %dialog{id: "edit-dealz-dialog-#{dealz.id}"}
            %h3 Edit Dealzs
            = render 'dealzs/edit_modal', dealz: dealz
            %button{type: "button", onclick: "document.getElementById('edit-dealz-dialog-#{dealz.id}').close()"} Cancel
        %td
          %button{type: "button", style: "background-color: oklch(0.514 0.222 16.935);", onclick: "document.getElementById('destroy-dealz-dialog-#{dealz.id}').showModal()"} Destroy
          %dialog{id: "destroy-dealz-dialog-#{dealz.id}"}
            %h3 Destroy dealz
            = render 'dealzs/destroy_modal', dealz: dealz
            %button{type: "button", onclick: "document.getElementById('destroy-dealz-dialog-#{dealz.id}').close()"} Cancel

%br

= link_to 'New Dealz', new_dealz_path
