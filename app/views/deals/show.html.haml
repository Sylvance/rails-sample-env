- if notice
  %p#notice= notice

%h1 Show Deal

%p
  %b Item:
  = @deal.item_id
%p
  %b Transaction record:
  = @deal.transaction_record_id
%p
  %b Quantity:
  = @deal.quantity
%p
  %b Price:
  = @deal.price
%p
  %b Vat rate:
  = @deal.vat_rate_id
%p
  %b Total excl vat:
  = @deal.total_excl_vat
%p
  %b Total incl vat:
  = @deal.total_incl_vat

= link_to 'Edit', edit_deal_path(@deal)
\|
= link_to 'Back', deals_path
\|
= link_to 'Go to Item', item_path(@deal.item)
