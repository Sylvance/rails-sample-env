- if notice
  %p#notice= notice

%p
  %b Transaction date:
  = @transaction_record.transaction_date
%p
  %b Notes:
  = @transaction_record.notes
%p
  %b Total amount excl vat:
  = @transaction_record.total_amount_excl_vat
%p
  %b Total amount incl vat:
  = @transaction_record.total_amount_incl_vat
%p
  %b Company:
  = @transaction_record.company
%p
  %b Customer:
  = @transaction_record.customer
%p
  %b User:
  = @transaction_record.user

= link_to 'Edit', edit_transaction_record_path(@transaction_record)
\|
= link_to 'Back', transaction_records_path
